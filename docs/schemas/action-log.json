{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ActionLogEntry",
  "description": "Single action log entry for an exception",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "exceptionId": { "type": "string" },
    "userId": { "type": "string" },
    "userName": { "type": "string" },
    "timestampUtc": { "type": "string", "format": "date-time" },
    "actionType": {
      "type": "string",
      "enum": ["created", "status_change", "reassigned", "comment", "updated"]
    },
    "message": { "type": "string" }
  },
  "required": ["id", "exceptionId", "userId", "userName", "timestampUtc", "actionType"],
  "additionalProperties": false
}
